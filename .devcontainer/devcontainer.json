{
  "name": "Linux Desktop PC (High-FPS Web + Chrome)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--shm-size=2gb"
  ],
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    6901
  ],
  "portsAttributes": {
    "6901": {
      "label": "Linux Desktop PC (Web)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postStartCommand": "bash /usr/local/bin/start-desktop.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
